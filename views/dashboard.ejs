<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Announcement Bot</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #1a1a2e; color: #eee; min-height: 100vh; }
.header { background: #16213e; padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #2a2a4a; }
.header h1 { font-size: 20px; }
.header .user { display: flex; align-items: center; gap: 10px; }
.header .user img { width: 32px; height: 32px; border-radius: 50%; }
.header .user a { color: #888; text-decoration: none; font-size: 14px; }
.container { max-width: 720px; margin: 32px auto; padding: 0 16px; }
.card { background: #16213e; border-radius: 12px; padding: 32px; margin-bottom: 24px; }
.card h2 { margin-bottom: 20px; font-size: 18px; }
.form-group { margin-bottom: 16px; }
.form-group label { display: block; margin-bottom: 6px; font-size: 14px; color: #aaa; }
.form-group input, .form-group textarea, .form-group select { width: 100%; padding: 10px 12px; background: #0f3460; border: 1px solid #2a2a4a; border-radius: 6px; color: #eee; font-size: 14px; }
.form-group textarea { resize: vertical; min-height: 80px; font-family: inherit; }
.form-row { display: flex; gap: 12px; }
.form-row .form-group { flex: 1; }
.field-group { background: #0f3460; border-radius: 8px; padding: 16px; margin-bottom: 12px; }
.field-group .form-row { gap: 8px; }
.field-group .form-row .form-group { flex: 1; }
.field-group .form-group { margin-bottom: 8px; }
.field-group label { font-size: 12px; }
.btn-remove { background: #da373c; color: #fff; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 12px; }
.btn-add { background: #2a2a4a; color: #eee; border: 1px solid #3a3a5a; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 13px; margin-top: 8px; }
.btn-submit { background: #5865F2; color: #fff; border: none; padding: 12px 32px; border-radius: 8px; cursor: pointer; font-size: 15px; font-weight: 600; width: 100%; }
.btn-submit:hover { background: #4752c4; }
#preview { background: #0f3460; border-radius: 8px; padding: 16px; margin-top: 16px; border-left: 4px solid #5865F2; }
#preview h3 { margin-bottom: 8px; }
#preview p { color: #ccc; font-size: 14px; line-height: 1.5; }
#preview .footer { color: #888; font-size: 12px; margin-top: 8px; }
#preview .fields { margin-top: 12px; }
#preview .field { margin-bottom: 8px; }
#preview .field strong { font-size: 13px; }
#preview .field span { font-size: 13px; color: #ccc; }
.alert { padding: 12px; border-radius: 6px; margin-bottom: 16px; font-size: 14px; }
.alert-success { background: #1a4a2e; color: #6fcf97; }
.alert-error { background: #4a1a1a; color: #cf6f6f; }
input[type="color"] { height: 40px; padding: 4px; }
</style>
</head>
<body>
<div class="header">
  <h1>Announcement Bot</h1>
  <div class="user">
    <% if (user.avatar) { %>
      <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="">
    <% } else { %>
      <img src="https://cdn.discordapp.com/embed/avatars/0.png" alt="">
    <% } %>
    <span><%= user.globalName || user.username %></span>
    <a href="/logout">Logout</a>
  </div>
</div>

<div class="container">
  <% if (guilds.length === 0) { %>
    <div class="card">
      <h2>No servers configured</h2>
      <p style="color:#888;margin-bottom:16px;">Invite the bot to a server and use <code>/setchannel</code> to set the announcement channel.</p>
    </div>
  <% } else { %>

  <div class="card">
    <h2>New Announcement</h2>
    <form id="announceForm">
      <div class="form-group">
        <label>Server</label>
        <select name="guildId" required>
          <% guilds.forEach(g => { %>
            <option value="<%= g.id %>"><%= g.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Title *</label>
        <input type="text" name="title" required oninput="updatePreview()">
      </div>
      <div class="form-group">
        <label>Description *</label>
        <textarea name="description" required oninput="updatePreview()"></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Color</label>
          <input type="color" name="color" value="#5865F2" oninput="updatePreview()">
        </div>
        <div class="form-group">
          <label>Image URL</label>
          <input type="url" name="image" placeholder="https://..." oninput="updatePreview()">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Thumbnail URL</label>
          <input type="url" name="thumbnail" placeholder="https://..." oninput="updatePreview()">
        </div>
        <div class="form-group">
          <label>Footer</label>
          <input type="text" name="footer" placeholder="Footer text" oninput="updatePreview()">
        </div>
      </div>
      <div class="form-group">
        <label>
          <input type="checkbox" name="timestamp" value="true" onchange="updatePreview()">
          Add timestamp
        </label>
      </div>

      <label style="display:block;margin-bottom:8px;font-size:14px;color:#aaa;">Fields</label>
      <div id="fieldsContainer"></div>
      <button type="button" class="btn-add" onclick="addField()">+ Add Field</button>

      <div id="preview">
        <h3 id="previewTitle">Title</h3>
        <p id="previewDesc">Description</p>
        <div id="previewFields" class="fields"></div>
        <div id="previewFooter" class="footer"></div>
      </div>

      <button type="submit" class="btn-submit" style="margin-top:20px">Send Announcement</button>
    </form>
    <div id="result"></div>
  </div>
  <% } %>
</div>

<script>
let fieldCount = 0
function addField(name, value, inline) {
  fieldCount++
  const div = document.createElement('div')
  div.className = 'field-group'
  div.id = 'field-' + fieldCount
  div.innerHTML = `
    <div class="form-row">
      <div class="form-group"><input type="text" name="fieldName" placeholder="Field name" value="${name || ''}" oninput="updatePreview()"></div>
      <div class="form-group"><input type="text" name="fieldValue" placeholder="Field value" value="${value || ''}" oninput="updatePreview()"></div>
      <div style="display:flex;align-items:center;gap:4px;padding-top:6px">
        <label style="font-size:12px;white-space:nowrap"><input type="checkbox" name="fieldInline" ${inline ? 'checked' : ''} onchange="updatePreview()"> Inline</label>
        <button type="button" class="btn-remove" onclick="removeField(${fieldCount})">✕</button>
      </div>
    </div>`
  document.getElementById('fieldsContainer').appendChild(div)
}

function removeField(id) {
  const el = document.getElementById('field-' + id)
  if (el) el.remove()
  updatePreview()
}

function getFields() {
  const groups = document.querySelectorAll('.field-group')
  return Array.from(groups).map(g => {
    const inputs = g.querySelectorAll('input')
    return { name: inputs[0].value, value: inputs[1].value, inline: inputs[2].checked }
  }).filter(f => f.name || f.value)
}

function updatePreview() {
  const title = document.querySelector('[name="title"]').value || 'Title'
  const desc = document.querySelector('[name="description"]').value || 'Description'
  const color = document.querySelector('[name="color"]').value
  const footer = document.querySelector('[name="footer"]').value
  const timestamp = document.querySelector('[name="timestamp"]').checked
  const fields = getFields()

  document.getElementById('preview').style.borderLeftColor = color
  document.getElementById('previewTitle').textContent = title
  document.getElementById('previewDesc').textContent = desc
  document.getElementById('previewFooter').textContent = (footer ? footer : '') + (timestamp ? (footer ? ' • ' : '') + new Date().toLocaleString() : '')

  const fieldsDiv = document.getElementById('previewFields')
  fieldsDiv.innerHTML = fields.map(f => `<div class="field"><strong>${f.name}</strong> <span>${f.value}</span></div>`).join('')
}

document.getElementById('announceForm')?.addEventListener('submit', async (e) => {
  e.preventDefault()
  const fd = new FormData(e.target)
  const data = { guildId: fd.get('guildId'), title: fd.get('title'), description: fd.get('description'), color: fd.get('color'), image: fd.get('image'), thumbnail: fd.get('thumbnail'), footer: fd.get('footer'), timestamp: fd.get('timestamp') === 'true', fields: getFields() }
  const btn = e.target.querySelector('.btn-submit')
  btn.disabled = true; btn.textContent = 'Sending...'
  try {
    const res = await fetch('/api/announce', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
    const text = await res.text()
    document.getElementById('result').innerHTML = res.ok ? '<div class="alert alert-success">' + text + '</div>' : '<div class="alert alert-error">' + text + '</div>'
  } catch (err) {
    document.getElementById('result').innerHTML = '<div class="alert alert-error">' + err.message + '</div>'
  }
  btn.disabled = false; btn.textContent = 'Send Announcement'
})
</script>
</body>
</html>
